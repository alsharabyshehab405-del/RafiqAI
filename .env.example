# RafiqAI backend environment template.
# Put real values in Replit Secrets / Environment Variables, never in source control.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=REPLACE_IN_REPLIT_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Primary AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=REPLACE_IN_REPLIT_SECRET
AI_MODEL=gpt-4.1-mini
AI_PRO_MODEL=gpt-4.1-mini
AI_PREMIUM_MODEL=gpt-4.1-mini
AI_PROVIDER_TYPE=openai_compatible
AI_PRO_PROVIDER_TYPE=openai_compatible
AI_PREMIUM_PROVIDER_TYPE=openai_compatible
AI_TIMEOUT_SECONDS=90
AI_MAX_CONTEXT_MESSAGES=40
AI_CONTEXT_TOKENS=16000
AI_MAX_CONTEXT_CHARS=50000
AI_SUMMARY_THRESHOLD_CHARS=30000
AI_MAX_TOOL_CALLS=12
AI_MAX_AGENT_SECONDS=90
AI_SUMMARY_ENABLED=true
AI_PROMPT_CACHE_ENABLED=false
AI_INPUT_COST_PER_1K=0
AI_OUTPUT_COST_PER_1K=0

# Optional provider fallback / multi-provider configuration
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_API_KEY=
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_GEMINI_API_KEY=

# Embeddings / RAG
EMBEDDING_PROVIDER_TYPE=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=rafiq
QDRANT_TIMEOUT_SECONDS=15

# Redis / rate limiting / worker queue
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
RATE_LIMIT_STORAGE_URI=redis://USER:PASSWORD@HOST:6379/0
AUTOMATION_POLL_SECONDS=30

# Database pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# API / security
CORS_ORIGINS=https://YOUR-REPLIT-DOMAIN
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_CHARS=12000
MAX_FILE_BYTES=15728640
MAX_FILE_UNCOMPRESSED_BYTES=100000000
LOG_LEVEL=INFO
SERVICE_NAME=rafiq-api
SENTRY_DSN=

# Web search
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=15

# Object storage / uploads
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLAMAV_URL=

# Google Play / FCM / billing
GOOGLE_PLAY_PACKAGE_NAME=com.rafiqai.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_ENABLED=true
PRO_PRODUCT_IDS=rafiq_pro_monthly,rafiq_pro_yearly
PREMIUM_PRODUCT_IDS=rafiq_premium_monthly,rafiq_premium_yearly
PRODUCT_PRICES_USD=rafiq_pro_monthly=4.99,rafiq_pro_yearly=49.99,rafiq_premium_monthly=9.99,rafiq_premium_yearly=99.99

# Application data / administration
ANALYTICS_ENABLED=true
MEMORY_ENABLED_BY_DEFAULT=false
DATA_RETENTION_DAYS=365
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_TOKEN=
BROWSER_ALLOWED_DOMAINS=
ADMIN_SESSION_MAX_MINUTES=30

# Replit injects PORT at runtime. Do not hardcode it in the application.
# PORT is intentionally not stored as a secret.
